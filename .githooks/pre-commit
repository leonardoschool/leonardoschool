#!/bin/sh
#
# Blocks commits that contain secrets.
#
# This repository is PUBLIC: anything committed here is world-readable and stays in history
# even if removed later. A real Firebase Storage download token once reached a test file this
# way and was only caught the next day by GitGuardian, after it was already public.
#
# Uses gitleaks when available (broader coverage) and always runs the built-in patterns below,
# so protection does not depend on every developer installing an extra binary.
#
# Bypass for a verified false positive: git commit --no-verify

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

# ── gitleaks, if installed ────────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner; then
    echo ""
    echo "  gitleaks ha rilevato un possibile segreto (vedi sopra)."
    fail=1
  fi
fi

# ── Built-in patterns ─────────────────────────────────────────────────────────
# Only added lines are inspected, so pre-existing content never blocks a commit.
added=$(git diff --cached -U0 | grep '^+' | grep -v '^+++' || true)

report() {
  echo ""
  echo "  BLOCCATO: $1"
  echo "  $2"
  fail=1
}

# Firebase Storage download tokens grant read access to the stored object.
if printf '%s' "$added" | grep -qiE 'alt=media&token=[0-9a-f]{8}-[0-9a-f]{4}'; then
  report "token di download Firebase Storage" \
    "Usa un UUID finto nei test (es. 00000000-0000-4000-8000-000000000000)."
fi

if printf '%s' "$added" | grep -qE 'AIza[0-9A-Za-z_-]{35}'; then
  report "Google/Firebase API key" "Spostala in una variabile d'ambiente."
fi

if printf '%s' "$added" | grep -qE 'BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY'; then
  report "chiave privata" "Le chiavi private non vanno mai versionate."
fi

if printf '%s' "$added" | grep -qiE '(postgres|postgresql|mysql|mongodb(\+srv)?)://[^:]+:[^@[:space:]]+@'; then
  report "stringa di connessione con password" "Usa DATABASE_URL da env/."
fi

if printf '%s' "$added" | grep -qE 'ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{22,}'; then
  report "GitHub token" "Revocalo subito su github.com/settings/tokens."
fi

if printf '%s' "$added" | grep -qE '"private_key"[[:space:]]*:'; then
  report "service account JSON" "Le credenziali service account non vanno versionate."
fi

# Any .env file other than the tracked templates under env/.
for file in $staged; do
  case "$file" in
    env/*) ;;
    *.env|.env|.env.*)
      report "file di ambiente ($file)" "I file .env non vanno committati."
      ;;
  esac
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "  Commit annullato. Il repository e' pubblico: rimuovi il segreto prima di procedere."
  echo "  Se e' un falso positivo: git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
