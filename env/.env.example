# ==================== TEMPLATE ENVIRONMENT VARIABLES ====================
# Copia questo file e rinominalo per il tuo ambiente
# NON inserire valori reali in questo file - è committato su Git!

# ==================== DATABASE ====================
# Locale (Docker): postgresql://postgres:postgres@localhost:5433/leonardoschool?schema=public
# Neon (Cloud): postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ==================== FIREBASE ====================
# Ottieni da: Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
FIREBASE_LEGACY_SERVICE_ACCOUNT_KEY=your_service_account_key_json_string_legacy

# Firebase Cloud Messaging (per push notifications web)
# Ottieni da: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
# Clicca "Generate key pair" se non esiste
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# Firebase Cloud Messaging (per push notifications web)
# Ottieni da: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
# Clicca "Generate key pair" se non esiste
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# Firebase Admin SDK (da Firebase Console > Project Settings > Service Accounts)
# Scarica JSON e incolla come stringa su UNA SOLA riga
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ==================== APP CONFIG ====================
# Locale: http://localhost:3000
# Test: https://your-app-test.vercel.app
# Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ==================== EMAIL / SMTP ====================
# L'INVIO delle email dall'app passa da Resend (evita rate-limit/blocco casella).
# La casella di RICEZIONE (leggere la posta) resta su Aruba: sono due cose separate.
#
# --- Resend via SMTP (consigliato) ---
#   SMTP_HOST="smtp.resend.com"
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER="resend"                      # username letterale "resend" (non un'email)
#   SMTP_PASSWORD="re_xxxxxxxxxxxxxxxx"      # la Resend API key (Dashboard > API Keys)
#   EMAIL_FROM="info@leonardoschool.it"     # il dominio DEVE essere verificato su Resend
#
# --- Aruba (vecchia config, solo fallback) ---
#   SMTP_HOST="smtps.aruba.it" / SMTP_USER="info@leonardoschool.it" / SMTP_PASSWORD="password casella"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASSWORD="re_your_resend_api_key"
EMAIL_FROM="your_verified_sender@your-domain.com"
EMAIL_TO="your_admin@domain.com"

# ==================== RECAPTCHA ====================
# Ottieni da: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key